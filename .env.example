# ─────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────
APP_NAME=Cortex Gateway
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ─────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cortex_gateway
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_password

# Computed from above – override only if using an external DB URL
DATABASE_URL=postgresql+asyncpg://cortex:cortex_password@localhost:5432/cortex_gateway

# ─────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# Computed from above – override only if using an external Redis URL
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────
# IMPORTANT: Replace with a strong random value in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-characters

# ─────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────
# Options: TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────
# LLM Providers (Phase 2)
# ─────────────────────────────────────────────────────
# WARNING: Never commit real API keys to version control.
# Set these values in your local .env file only.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Gateway Routing
DEFAULT_PROVIDER=groq
PROVIDER_TIMEOUT_SECONDS=30
